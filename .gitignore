# Dependency directories
node_modules/
frontend/node_modules/

# Production build outputs
dist/
frontend/dist/
build/

# Local env files
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env.local

# Linter caches
.eslintcache

